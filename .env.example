ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed if you want draft emails auto-created in Buttondown
# for new meetings. Get this from Buttondown Settings > Programming > API Key.
BUTTONDOWN_API_KEY=...

# Optional — only needed if you're targeting each township's drafts to just
# that township's tagged subscribers (see README's "Buttondown" section).
# Get each tag's ID from Buttondown's Tags dashboard, or GET /v1/tags.
# If unset, that township's drafts go out untargeted (to everyone).
BUTTONDOWN_TAG_TREDYFFRIN=sub_tag_...
BUTTONDOWN_TAG_UPPER_MERION=sub_tag_...
BUTTONDOWN_TAG_LIMERICK=sub_tag_...
